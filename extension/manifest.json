{
  "manifest_version": 3,
  "name": "Nowa Rola — aplikacje",
  "version": "1.0.0",
  "description": "Wypełnia formularze aplikacyjne z Twoich danych, CV i bazy odpowiedzi. Zapisuje wysłane aplikacje w trackerze Nowa Rola.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:43123/*",
    "http://localhost:43123/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.teamtailor.com/*",
    "https://*.recruitee.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://*.jobs.personio.de/*",
    "https://*.jobs.personio.com/*",
    "https://*.bamboohr.com/*",
    "https://*.breezy.hr/*",
    "https://*.pinpointhq.com/*",
    "https://*.traffit.com/*",
    "https://jobs.jobvite.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.teamtailor.com/*",
        "https://*.recruitee.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.jobs.personio.de/*",
        "https://*.jobs.personio.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.pinpointhq.com/*",
        "https://*.traffit.com/*",
        "https://jobs.jobvite.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*"
      ],
      "js": ["lib/form.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://127.0.0.1:43123/connect/extension*",
        "http://localhost:43123/connect/extension*"
      ],
      "js": ["pair.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nowa Rola",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
