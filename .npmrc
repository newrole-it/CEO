save-exact=true
legacy-peer-deps=true

# pnpm only. npm prints "Unknown project config public-hoist-pattern" and ignores it; with
# legacy-peer-deps npm hoists everything anyway. pnpm needs these hoisted for Blitz to work.
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=next
public-hoist-pattern[]=secure-password
public-hoist-pattern[]=*jest*
public-hoist-pattern[]=@testing-library/*
