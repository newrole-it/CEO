{
  "name": "@newrole/jobs-lab",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "A test bench for the offer engine (@newrole/ats, @newrole/job-index): read a board of any supported ATS live, one offer from its link, the boards a careers page links to, and a smoke run over real boards. Not part of newrole.it's release.",
  "scripts": {
    "dev": "next dev --webpack -p 43125 -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 43125",
    "smoke": "tsx scripts/smoke.ts",
    "db:prepare": "tsx scripts/db.ts",
    "seed": "tsx scripts/seed.ts",
    "index": "tsx scripts/index-board.ts",
    "worker": "tsx scripts/worker.ts",
    "harvest": "tsx scripts/harvest.ts",
    "catalog": "tsx scripts/catalog.ts",
    "identity-keys": "tsx scripts/migrate-identity-keys.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@newrole/app-kit": "0.1.0",
    "@newrole/ats": "0.1.0",
    "@newrole/job-index": "0.1.0",
    "@newrole/offers": "0.1.0",
    "@newrole/ui": "0.1.0",
    "@next/env": "16.4.3",
    "@prisma/client": "5.4.2",
    "lucide-react": "1.55.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.0.0",
    "typescript": "5.6.3",
    "vitest": "0.25.3"
  }
}
