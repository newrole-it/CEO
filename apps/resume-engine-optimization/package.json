{
  "name": "@newrole/app",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "newrole.it: your CV tailored to every job offer you add by its link, with a cover letter, an application tracker, an answer bank, an MCP server for Claude Code and a Chrome extension. Runs on your machine.",
  "scripts": {
    "dev": "next dev --webpack -p 43123 -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 43123",
    "mcp": "tsx mcp/server.ts",
    "studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs prepare",
    "test:flow": "node scripts/test-db.mjs run tsx --test --test-concurrency=1 \"test/*.test.ts\""
  },
  "dependencies": {
    "@blitzjs/auth": "3.0.2",
    "@blitzjs/next": "3.0.2",
    "@blitzjs/rpc": "3.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@newrole/app-kit": "0.1.0",
    "@newrole/ats": "0.1.0",
    "@newrole/cv-core": "0.1.0",
    "@newrole/cv-editor": "0.1.0",
    "@newrole/cv-engine": "0.1.0",
    "@newrole/llm": "0.1.0",
    "@newrole/matching": "0.1.0",
    "@newrole/offers": "0.1.0",
    "@newrole/profile": "0.1.0",
    "@newrole/profile-ui": "0.1.0",
    "@newrole/ui": "0.1.0",
    "@next/env": "16.4.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "blitz": "3.0.2",
    "concurrently": "10.0.7",
    "lucide-react": "1.70.0",
    "next": "16.4.3",
    "prisma": "7.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "secure-password": "4.0.0",
    "tsx": "4.23.15",
    "undici": "7.30.2",
    "unpdf": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.0.0",
    "autoprefixer": "10.6.2",
    "jsdom": "20.0.3",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  }
}
