# npm run go creates .env from this file with fresh secrets, so you do not need to copy it.
# Copy to .env.local to override. Defaults in .env are enough for a local scan
# of the seed boards, with no external API keys.

DATABASE_URL="postgresql://jobscanner:jobscanner@127.0.0.1:5432/jobscanner"
# Required by Docker Compose. No default is baked into the image.
POSTGRES_PASSWORD="jobscanner"
# Host port for the Docker database, when something else already uses 5432.
# npm run go picks one and writes it here and into DATABASE_URL.
# POSTGRES_PORT="55432"
# Docker Compose sets this to postgresql://jobscanner:jobscanner@db:5432/jobscanner

# Required in production. At least 32 characters. Signs session cookies.
# With a public APP_ORIGIN in production the app refuses to start on any sample value in this file.
SESSION_SECRET_KEY="replace-with-a-random-string-of-32-plus-chars"

# Single owner account created by `npm run db:seed`. npm run go writes these with a random password.
# The default address keeps the project's old name on purpose: changing it would create a second
# owner on installs that never set it.
OWNER_EMAIL="owner@nowarola.local"
OWNER_NAME="Owner"
OWNER_PASSWORD="jobscanner-local"

# LLM provider: claude-cli | openai | none. Empty picks claude-cli when the `claude` binary
# (Claude Code) is installed, else openai when LLM_API_KEY is set, else none (rules only).
# claude-cli runs `claude -p` on your own Claude subscription: no API key needed.
# Setting claude-cli here also turns on web search through Claude (see CLAUDE_SEARCH_DAILY_CAP).
LLM_PROVIDER=""
# Model alias for claude -p (haiku, sonnet, opus).
CLAUDE_CLI_MODEL="haiku"
# Only when `claude` is not on PATH or in ~/.local/bin.
CLAUDE_CLI_PATH=""
# Optional tuning. Defaults: 2 at once, 90 s each. Purposes listed here stay on rules
# (default role-classify, so indexing does not spend the subscription).
CLAUDE_CLI_MAX_CONCURRENT=""
CLAUDE_CLI_TIMEOUT_MS=""
# CLAUDE_CLI_SKIP_PURPOSES="role-classify"
# Model for text you send to employers (answer drafts, application forms). Default sonnet,
# 150 s per call.
CLAUDE_WRITING_MODEL=""
CLAUDE_WRITING_TIMEOUT_MS=""

# CV PDFs are printed by headless Chrome. Empty checks the standard macOS and Linux paths;
# without Chrome the CV editor falls back to the browser's "Print → Save as PDF".
CHROME_PATH=""

# Account the MCP server (npm run mcp) acts for. Empty: the only regular account, else the owner.
# The old name NOWAROLA_USER_EMAIL is still read when this one is empty.
NEWROLE_USER_EMAIL=""

# OpenAI-compatible API, including OpenAI and xAI. Used only without Claude Code,
# or with LLM_PROVIDER=openai. The Docker image has no Claude Code.
# xAI example: LLM_BASE_URL="https://api.x.ai/v1" LLM_MODEL="grok-2-latest"
# With no key and no claude CLI, the query expander and reasons are deterministic.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
# Optional. Token counts are always stored. USD cost is estimated only when these are set.
LLM_INPUT_USD_PER_MILLION=""
LLM_OUTPUT_USD_PER_MILLION=""

# Web search. Brave is primary. Serper is used when Brave is unset or a Brave call fails.
# A bounded worker pass uses hits to add offers the crawl missed and to copy an
# explicit salary onto the same role when the career page has none. Polish boards
# are not fetched. Raw search responses are not stored. Without either key, the
# pass does not run and scans stay on the verified seed boards.
BRAVE_SEARCH_API_KEY=""
SERPER_API_KEY=""
# claude: when both keys are empty, search through `claude -p` with only the WebSearch
# tool (your Claude subscription). LLM_PROVIDER=claude-cli also turns it on.
WEB_SEARCH_PROVIDER=""
CLAUDE_SEARCH_DAILY_CAP="40"

# How many seed boards to read per scan. 0 means the full verified catalog
# (main list plus Polish boards and employer career sites).
# Default 40 prefers the boards with the most offers.
SCAN_SEED_LIMIT="40"
# Countries whose offers never enter the index, ISO codes, comma separated. By design Russia and
# Belarus. Unset means RU,BY; an empty value blocks nothing.
BLOCKED_COUNTRIES="RU,BY"
# SmartRecruiters Posting API. Default off: robots.txt on api.smartrecruiters.com disallows
# every crawler except LinkedInBot. jobs.smartrecruiters.com pages stay allowed.
SMARTRECRUITERS_POSTING_API="off"
# Search requests one read of a Workday tenant may spend (20 postings each, 1 s apart). Default 5000.
# WORKDAY_CXS_MAX_REQUESTS="5000"

# How many site: queries to send per scan. Polish boards and Workday are never queried.
DISCOVERY_QUERY_LIMIT="14"
# Job-detail pages per career host per scan, capped at 200 per host per day.
CAREER_DETAIL_LIMIT="40"
# What the crawler's User-Agent says about who runs it and why. Set it on anything but your own
# job search, e.g. "contact: you@example.com; job search service".
CRAWLER_NOTE=""
# Sites whose owner asked not to be read, comma separated. Subdomains count.
CRAWLER_OPT_OUT_HOSTS=""

# off runs newrole.it without an index of offers: no crawl, no offer screens, only each person's
# own records. For a service run for other people: gathering vacancies as a business is a
# regulated activity in Poland (Dz.U. 2025 poz. 620, art. 305 ust. 2 pkt 1 lit. c).
OFFER_INDEX=""

# Who answers for a server other people use: shown on /privacy, /terms and /bot. A local install
# needs none of them, and the code holds no default.
OPERATOR_NAME=""
OPERATOR_CONTACT=""
# Companies that process data for you and where, in one sentence.
OPERATOR_PROCESSORS=""

# Recruitee careers calls stay open without a token until 10 February 2027.
# After that, or on HTTP 401, those boards are skipped instead of failing the scan.
RECRUITEE_CAREERS_TOKEN=""

# Neutral match profile. This is not a personal salary or location preference.
# Floor 1 keeps undisclosed salaries neutral and lets any disclosed salary clear the floor.
MATCH_SALARY_FLOOR_PLN="1"
MATCH_ACCEPTED_CONTRACTS=""
MATCH_HOME_CITY="Warsaw"
MATCH_HOME_COUNTRY="PL"
MATCH_HYBRID_CITIES="Warsaw,Kraków,Wrocław,Gdańsk,Poznań,Łódź,Katowice"
MATCH_RELOCATION_OK="true"

# Exchange rates into PLN come from NBP table A (api.nbp.pl), read every 12 hours.
# off keeps the defaults in matching/config.ts and calls nothing.
NBP_RATES=""
# Optional FX overrides (PLN per 1 unit). They win over NBP. FX_<CODE>_PLN works for any code NBP lists.
FX_EUR_PLN=""
FX_USD_PLN=""
FX_GBP_PLN=""
FX_CHF_PLN=""
FX_AS_OF=""

FETCH_TIMEOUT_MS="15000"
FETCH_MAX_BYTES="1500000"

# Public origin used in magic links and the LinkedIn redirect.
APP_ORIGIN="http://127.0.0.1:43123"

# 1 when a reverse proxy in front of the app sets X-Forwarded-For. Empty ignores that header, so
# sign-in limits per address count every request together.
TRUST_PROXY=""

# Canonical public URL for metadata, Open Graph, and the crawler contact page.
# Magic links stay on APP_ORIGIN so a local sign-in link does not point at production.
APP_URL="https://newrole.it"

# LinkedIn OpenID Connect. Leave empty to hide a working LinkedIn login.
# Create an app at https://www.linkedin.com/developers/apps, add the Sign In with
# LinkedIn using OpenID Connect product, and set the redirect URL to
# ${APP_ORIGIN}/api/auth/linkedin/callback
# Scopes: openid, profile, email. LinkedIn does not provide a CV.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional override. Defaults to ${APP_ORIGIN}/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=""

# Gmail: no mailbox is connected any more. A company's reply is used from the extension, on the
# message you have open (docs/product/plan-gmail.md). Keep the key below only if you connected a
# mailbox in an earlier version and set it then: it opens that token so Settings → Gmail can revoke it.
GMAIL_TOKEN_KEY=""

# Profile from LinkedIn without a LinkedIn app: Claude reads your own profile in your
# Chrome (Claude in Chrome extension). Offered only when APP_ORIGIN is a loopback address.
# on forces it, off hides it. Model defaults to CLAUDE_CLI_MODEL.
LINKEDIN_BROWSER_IMPORT=""
LINKEDIN_BROWSER_MODEL=""

# Magic-link email. console (default) prints the link in the server log.
# resend uses RESEND_API_KEY. smtp uses SMTP_HOST.
EMAIL_PROVIDER="console"
EMAIL_FROM='"newrole.it" <login@jobscanner.local>'
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
