{
  "name": "newrole",
  "version": "1.0.0",
  "description": "newrole.it: your CV tailored to every job offer, on your machine. npm workspaces: the apps under apps/ and the packages they are made of under packages/.",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/newrole",
    "apps/cv"
  ],
  "scripts": {
    "go": "node scripts/go.mjs",
    "setup": "node scripts/go.mjs --prepare",
    "prepare": "husky install",
    "dev": "npm run dev -w @newrole/app",
    "worker": "npm run worker -w @newrole/app",
    "harvest": "npm run harvest -w @newrole/app",
    "catalog": "npm run catalog -w @newrole/app",
    "mcp": "npm run --silent mcp -w @newrole/app",
    "cv": "npm run dev -w @newrole/cv-app",
    "cv:build": "npm run build -w @newrole/cv-app",
    "cv:start": "npm run start -w @newrole/cv-app",
    "export:cv": "node scripts/export-cv.mjs",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker\"",
    "build": "npm run build -w @newrole/app",
    "start": "npm run start -w @newrole/app",
    "studio": "npm run studio -w @newrole/app",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:workspaces && npm run test:extension && npm run test:flow",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:flow": "npm run test:flow -w @newrole/app",
    "test:db": "node scripts/test-db.mjs prepare",
    "db:deploy": "npm run db:deploy -w @newrole/app",
    "db:seed": "npm run db:seed -w @newrole/app",
    "db:migrate": "npm run db:migrate -w @newrole/app",
    "ext:build": "node scripts/go.mjs --extension",
    "ext:dev": "node scripts/go.mjs --extension && npm run dev --prefix apps/extension",
    "test:extension": "vitest run --root apps/extension"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "8.0.2",
    "lint-staged": "13.0.3",
    "prettier": "^2.7.1",
    "prettier-plugin-prisma": "4.4.0",
    "pretty-quick": "3.1.3",
    "typescript": "5.6.3"
  }
}
