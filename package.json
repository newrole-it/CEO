{
  "name": "nowarola",
  "version": "1.0.0",
  "description": "Nowa Rola: a personal job finder that reads public ATS boards and career pages, with a worker, an MCP server for Claude Code, and a Chrome extension.",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "go": "node scripts/go.mjs",
    "setup": "node scripts/go.mjs --prepare",
    "prepare": "husky install",
    "dev": "blitz dev --webpack -p 43123 -H 127.0.0.1",
    "worker": "tsx src/worker.ts",
    "mcp": "tsx mcp/server.ts",
    "dev:all": "concurrently -k -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker\"",
    "build": "blitz codegen && next build --webpack",
    "start": "blitz start -H 127.0.0.1 -p 43123",
    "studio": "blitz prisma studio",
    "lint": "eslint .",
    "test": "vitest run && npm test --prefix matching && npm run test:flow",
    "test:watch": "vitest",
    "test:flow": "node scripts/test-db.mjs run tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "test:db": "node scripts/test-db.mjs prepare",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "ext:build": "node scripts/go.mjs --extension",
    "ext:dev": "node scripts/go.mjs --extension && npm run dev --prefix extension"
  },
  "prisma": {
    "schema": "db/schema.prisma",
    "seed": "tsx db/seed.ts"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@blitzjs/auth": "3.0.2",
    "@blitzjs/next": "3.0.2",
    "@blitzjs/rpc": "3.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/client": "5.4.2",
    "blitz": "3.0.2",
    "concurrently": "10.0.6",
    "lucide-react": "1.55.0",
    "next": "16.4.3",
    "prisma": "5.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "secure-password": "4.0.0",
    "tsx": "4.23.15",
    "undici": "7.30.1",
    "unpdf": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@types/node": "22.20.5",
    "@types/react": "19.0.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "8.0.2",
    "jsdom": "20.0.3",
    "lint-staged": "13.0.3",
    "postcss": "8.5.29",
    "prettier": "^2.7.1",
    "prettier-plugin-prisma": "4.4.0",
    "pretty-quick": "3.1.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite-tsconfig-paths": "3.6.0",
    "vitest": "0.25.3"
  }
}
