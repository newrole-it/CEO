{
  "name": "newrole",
  "version": "1.0.0",
  "description": "newrole.it: your CV tailored to every job offer, on your machine. npm workspaces: each app under apps/ with the packages it is made of in its own packages/ folder.",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/resume-engine-optimization",
    "apps/resume-engine-optimization/packages/*",
    "apps/jobs-lab",
    "apps/jobs-lab/packages/*"
  ],
  "scripts": {
    "go": "node scripts/go.mjs",
    "setup": "node scripts/go.mjs --prepare",
    "prepare": "husky install",
    "dev": "npm run dev -w @newrole/app",
    "mcp": "npm run --silent mcp -w @newrole/app",
    "build": "npm run build -w @newrole/app",
    "start": "npm run start -w @newrole/app",
    "studio": "npm run studio -w @newrole/app",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:workspaces && npm run test:extension && npm run test:flow",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:flow": "npm run test:flow --workspaces --if-present",
    "test:db": "npm run test:db --workspaces --if-present",
    "db:deploy": "npm run db:deploy -w @newrole/app",
    "db:seed": "npm run db:seed -w @newrole/app",
    "db:migrate": "npm run db:migrate -w @newrole/app",
    "ext:build": "node scripts/go.mjs --extension",
    "ext:dev": "node scripts/go.mjs --extension && npm run dev --prefix apps/reo-extension",
    "test:extension": "vitest run --root apps/reo-extension"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "trailingComma": "es5",
    "plugins": [
      "prettier-plugin-prisma"
    ]
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@blitzjs/auth": "3.0.2",
    "@blitzjs/next": "3.0.2",
    "blitz": "3.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "8.0.2",
    "lint-staged": "13.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-prisma": "5.0.0",
    "pretty-quick": "4.2.2",
    "typescript": "5.6.3"
  },
  "overrides": {
    "blitz": {
      "tar": "7.5.22",
      "esbuild": "0.28.2",
      "node-fetch": "3.3.2",
      "semver": "7.8.5",
      "diff": "5.2.2",
      "cross-spawn": "7.0.6"
    },
    "@blitzjs/generator": {
      "@babel/core": "7.29.7",
      "zod": "4.6.7",
      "diff": "5.2.2",
      "cross-spawn": "7.0.6"
    },
    "@blitzjs/auth": {
      "nanoid": "3.3.20",
      "cookie": "0.7.2"
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "7.1.4"
    },
    "jscodeshift": {
      "micromatch": "4.0.8"
    },
    "execa": {
      "cross-spawn": "7.0.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
