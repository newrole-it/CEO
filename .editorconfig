# What the repository already uses: two spaces, LF, a final newline. Prettier ("prettier" in
# package.json) also sets no semicolons and printWidth 100.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,jsx,ts,tsx,json,css}]
max_line_length = 100

# The SQL migrations (apps/*/db/migrations) use four spaces.
[*.sql]
indent_size = 4
